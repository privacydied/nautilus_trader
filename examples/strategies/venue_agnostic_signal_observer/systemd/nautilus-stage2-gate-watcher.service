[Unit]
Description=NautilusTrader Stage 2 derivatives gate watcher
Documentation=https://github.com/privacydied/nautilus_trader
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/mnt/nasirjones/py/nautilus_trader
Environment=PYTHONUNBUFFERED=1
ExecStart=/mnt/nasirjones/py/nautilus_trader/.venv/bin/python -u -m examples.strategies.venue_agnostic_signal_observer.run_stage2_gate_watcher --interval-seconds 30 --max-runtime-seconds 0 --preflight-seconds 60 --fast-duration-seconds 900 --full-duration-seconds 1800 --oi-interval-seconds 5 --prefer-gpu --notify --sound
Restart=no
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=default.target
